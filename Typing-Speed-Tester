import time
import random
sentences = [
    "Python is a simple and powerful programming language.",
    "Practice makes a person perfect.",
    "Technology makes our daily life easier.",
    "Learning Python is fun and interesting."
]
print("=== Typing Speed Tester ===")
print("Type the following sentence as quickly as possible.\n")
sentence = random.choice(sentences)
print("Sentence:", sentence)
input("Press Enter when you are ready to start...")
start_time = time.time()
typed_text = input("\nType here: ")
end_time = time.time()
time_taken = end_time - start_time
minutes = time_taken / 60
if minutes > 0:
    words = len(typed_text.split())
    wpm = words / minutes
else:
    wpm = 0
correct_chars = sum(
    1 for a, b in zip(typed_text, sentence) if a == b
)
accuracy = (correct_chars / len(sentence)) * 100
print("\n=== Typing Test Results ===")
print("Time Taken:", round(time_taken, 2), "seconds")
print("Typing Speed:", round(wpm, 2), "WPM")
print("Accuracy:", round(accuracy, 2), "%")
print("Correct Characters:", correct_chars, "/", len(sentence))



